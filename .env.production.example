# Copy to .env on the Laravel server and fill private values there.
# Rotate any credentials previously accessible through the web server.
APP_NAME=MKPOS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.mkposmyanmar.com/public
MKPOS_PAYMENTS_MCP_TOKEN=
MKPOS_WEB_URL=https://app.mkposmyanmar.com
MKPOS_OFFICE_URL=https://office.mkposmyanmar.com
MKPOS_MOBILE_URL=https://mobile.mkposmyanmar.com
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mkpos
DB_USERNAME=mkpos_app
DB_PASSWORD=
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
AUTH_TOKEN_EXPIRATION_MINUTES=43200
SANCTUM_STATEFUL_DOMAINS=www.mkposmyanmar.com,mkposmyanmar.com,app.mkposmyanmar.com,office.mkposmyanmar.com,mobile.mkposmyanmar.com,shop.mkposmyanmar.com
CORS_ALLOWED_ORIGINS=https://www.mkposmyanmar.com,https://mkposmyanmar.com,https://app.mkposmyanmar.com,https://office.mkposmyanmar.com,https://mobile.mkposmyanmar.com,https://shop.mkposmyanmar.com,https://localhost,capacitor://localhost
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=auth@example.com
MAIL_FROM_NAME=MKPOS
# Optional overrides; fields not set inherit MAIL_*.
MAIL_AUTH_FROM_ADDRESS=auth@example.com
MAIL_SUBSCRIPTION_FROM_ADDRESS=billing@example.com
MAIL_MESSAGES_FROM_ADDRESS=support@example.com
# Set MAIL_AUTH_*, MAIL_SUBSCRIPTION_* and MAIL_MESSAGES_* credentials privately.
SHOP_CHAT_ENABLED=true
SHOP_CHAT_REALTIME_ENABLED=true
SHOP_CHAT_APP_SECRET=
# Public browser socket connection on the separate Node server.
SHOP_CHAT_SOCKET_HOST=socket.mkposmyanmar.com
SHOP_CHAT_SOCKET_SCHEME=https
SHOP_CHAT_SOCKET_PORT=443
SHOP_CHAT_SOCKET_PATH=/socket.io
# Laravel's signed publishing connection, also to the separate server.
SHOP_CHAT_PUBLISH_HOST=socket.mkposmyanmar.com
SHOP_CHAT_PUBLISH_SCHEME=https
SHOP_CHAT_PUBLISH_PORT=443

# In-app AI assistant (server-side credentials only)
MKPOS_AI_ENABLED=false
MKPOS_AI_MODEL=deepseek-flash
DEEPSEEK_API_KEY=

# Dedicated public Telegram customer-service bot
TELEGRAM_SUPPORT_ENABLED=false
TELEGRAM_SUPPORT_BOT_TOKEN=
TELEGRAM_SUPPORT_WEBHOOK_SECRET=
TELEGRAM_SUPPORT_WEBHOOK_URL=
TELEGRAM_SUPPORT_DAILY_LIMIT=200
TELEGRAM_SUPPORT_CHAT_DAILY_LIMIT=20
