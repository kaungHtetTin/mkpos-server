APP_NAME=MKPOS
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5174,localhost:5175,localhost:5176,127.0.0.1,127.0.0.1:5174,127.0.0.1:5175,127.0.0.1:5176,127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5175,http://localhost:5175,http://127.0.0.1:5176,http://localhost:5176,http://127.0.0.1:5177,http://localhost:5177
AUTH_TOKEN_EXPIRATION_MINUTES=43200

# Automatic trials are enabled only for businesses registered after deployment.
# Disable this flag to stop future grants; existing trial records remain valid.
TRIAL_ENABLED=true
TRIAL_MONTHS=1
TRIAL_OFFLINE_SYNC_GRACE_DAYS=7
TRIAL_PLAN_SLUG=free-trial
TRIAL_MONITOR_LOG_CHANNEL=trial_rollout
TRIAL_MONITOR_LOG_LEVEL=warning
TRIAL_MONITOR_LOG_DAYS=30

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mkpos
DB_USERNAME=mkpos_app
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
MKPOS_RELEASE_UPLOAD_MAX_MB=512
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Set true when deploying behind HTTPS; local HTTP development uses false.
SESSION_SECURE_COOKIE=false

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional per-action senders/SMTP accounts. Unset fields inherit MAIL_* above.
# Authentication: owner and customer password-reset OTPs.
# MAIL_AUTH_FROM_ADDRESS=auth@example.com
# MAIL_AUTH_FROM_NAME="MKPOS Security"
# MAIL_AUTH_HOST=smtp.example.com
# MAIL_AUTH_PORT=587
# MAIL_AUTH_ENCRYPTION=tls
# MAIL_AUTH_USERNAME=auth@example.com
# MAIL_AUTH_PASSWORD=
# Subscription approval confirmations.
# MAIL_SUBSCRIPTION_FROM_ADDRESS=billing@example.com
# MAIL_SUBSCRIPTION_FROM_NAME="MKPOS Billing"
# MAIL_SUBSCRIPTION_HOST=smtp.example.com
# MAIL_SUBSCRIPTION_PORT=587
# MAIL_SUBSCRIPTION_ENCRYPTION=tls
# MAIL_SUBSCRIPTION_USERNAME=billing@example.com
# MAIL_SUBSCRIPTION_PASSWORD=
# Office custom subject/message emails to customers and business owners.
# MAIL_MESSAGES_FROM_ADDRESS=support@example.com
# MAIL_MESSAGES_FROM_NAME="MKPOS Support"
# MAIL_MESSAGES_HOST=smtp.example.com
# MAIL_MESSAGES_PORT=587
# MAIL_MESSAGES_ENCRYPTION=tls
# MAIL_MESSAGES_USERNAME=support@example.com
# MAIL_MESSAGES_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
SHOP_CHAT_ENABLED=true
SHOP_CHAT_REALTIME_ENABLED=false
SHOP_CHAT_APP_SECRET=
SHOP_CHAT_SOCKET_HOST=127.0.0.1
SHOP_CHAT_SOCKET_PORT=8080
SHOP_CHAT_SOCKET_SCHEME=http
SHOP_CHAT_PUBLISH_HOST=127.0.0.1
SHOP_CHAT_PUBLISH_PORT=8080
SHOP_CHAT_PUBLISH_SCHEME=http
SHOP_CHAT_SOCKET_PATH=/socket.io
